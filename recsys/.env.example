# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# ── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...            # primary — gpt-4o-mini (ordering + SRM + admin parse)
ANTHROPIC_API_KEY=sk-ant-...          # optional fallback

# ── Google Cloud Speech-to-Text ───────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/google-credentials.json

# ── ElevenLabs TTS ────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Plivo (voice + SMS) ───────────────────────────────────
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_NUMBER=+1XXXXXXXXXX

# ── Deepgram (kept; Google STT is primary) ────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key

# ── Database (MySQL) ──────────────────────────────────────
DB_URL=mysql+pymysql://recsys:password@localhost/recsys

# ── App ───────────────────────────────────────────────────
BASE_PATH=/recsys
SECRET_KEY=change-me
PUBLIC_BASE_URL=https://your-host/recsys

# ── PayPal (sandbox) — Orders v2 + Subscriptions ──────────
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_MODE=sandbox

# ── SRM weekly email (optional; unset = simulate) ─────────
# Any SMTP works: Gmail app password, Brevo, SendGrid SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
